{
  "name": "snap",
  "version": "0.2.1",
  "description": "Simple, intuitive screenshot and screen recorder for Windows and macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ponya5.snap",
    "productName": "Snap",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "recorder.html",
      "home.html",
      "control.html",
      "icon.png",
      "countdown.html",
      "settings.html",
      "frame.html",
      "preview.html",
      "updater.js"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": null,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Snap captures your screen for screenshots and recordings.",
        "NSMicrophoneUsageDescription": "Snap can record your microphone in screen recordings."
      }
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "author": "ponya5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponya5/snap.git"
  },
  "bugs": {
    "url": "https://github.com/ponya5/snap/issues"
  },
  "homepage": "https://github.com/ponya5/snap#readme",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
